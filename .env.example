DATABASE_URL=local.db
ORIGIN=http://localhost:5173

# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# `preview` writes mail to MAIL_PREVIEW_DIR, `smtp` sends it. Development always previews.
MAIL_TRANSPORT=preview
MAIL_FROM="Fernbill <invoices@fernbill.local>"
MAIL_PREVIEW_DIR=.mail-preview

# Only used when MAIL_TRANSPORT=smtp outside development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
